# Copy to .env (never commit .env). All values are synthetic lab defaults.

# secure (default) | vulnerable (enables the documented assessment scenarios; requires loopback binding)
LAB_MODE=secure
# Which scenarios to enable in vulnerable mode: all | comma list such as HMS-V01,HMS-V03
LAB_VULNS=all

# Backend bind. Keep 127.0.0.1. 0.0.0.0 is refused in vulnerable mode unless LAB_ALLOW_CONTAINER_BIND=1 (Compose only).
HOST=127.0.0.1
PORT=4000

# Leave empty to use the embedded PGlite database in ./.pglite. Set for PostgreSQL (Docker Compose does this for you).
DATABASE_URL=
# Docker Compose database password (synthetic).
POSTGRES_PASSWORD=medicore_lab_only_change_me

SESSION_TTL_MINUTES=60
LOG_LEVEL=info

# --- Security settings (see SECURITY.md) ---
# Mark the session cookie Secure and use the __Host- prefix. Default: on when NODE_ENV=production. Turn on whenever served over HTTPS.
# COOKIE_SECURE=1
# Number of reverse proxies in front of the API (so rate limits and the audit trail see real client addresses).
# TRUST_PROXY=1
# Serve the built front end (frontend/dist) from the API with a strict CSP.
# SERVE_FRONTEND=1
# Extra origins allowed to make state-changing requests (comma separated). The request's own host is always allowed.
# ALLOWED_ORIGINS=https://hms.example.org
# Hard session limit in hours, regardless of activity (default 12).
# SESSION_ABSOLUTE_HOURS=12
# Throttling: sign-in / 2FA / reset attempts per client per window, and API requests per client per minute.
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MIN=15
# RATE_LIMIT_API_MAX=600
