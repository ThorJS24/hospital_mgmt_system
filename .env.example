# Copy to .env (never commit .env). All values are synthetic lab defaults.

# secure (default) | vulnerable (enables the documented assessment scenarios; requires loopback binding)
LAB_MODE=secure
# Which scenarios to enable in vulnerable mode: all | comma list such as HMS-V01,HMS-V03
LAB_VULNS=all

# Backend bind. Keep 127.0.0.1. 0.0.0.0 is refused in vulnerable mode unless LAB_ALLOW_CONTAINER_BIND=1 (Compose only).
HOST=127.0.0.1
PORT=4000

# Leave empty to use the embedded PGlite database in ./.pglite. Set for PostgreSQL (Docker Compose does this for you).
DATABASE_URL=
# Docker Compose database password (synthetic).
POSTGRES_PASSWORD=medicore_lab_only_change_me

SESSION_TTL_MINUTES=60
LOG_LEVEL=info
