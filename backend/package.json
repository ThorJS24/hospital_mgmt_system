{
  "name": "medicore-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/cli.ts migrate",
    "seed": "tsx src/db/cli.ts seed",
    "reset": "tsx src/db/cli.ts reset",
    "report": "tsx src/assessment/reportCli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
